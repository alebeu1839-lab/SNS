# =============================================================
#  AI SNS Company - 環境変数テンプレート
#  使い方: cp .env.example .env して値を埋める。.env はコミットしない。
# =============================================================

# --- AIモデルAPI ------------------------------------------------
ANTHROPIC_API_KEY=
# モデルIDのデフォルト（各 agent.config.json で上書き可能）
DEFAULT_MODEL=claude-opus-4-8

# --- n8n -------------------------------------------------------
N8N_HOST=http://localhost:5678
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
# このリポジトリをn8nコンテナ内にマウントしたパス。
# agent-runner がここから agents/*/prompt.md と config を読む。
AGENT_REPO_PATH=/data/repo
# Code/Execute Workflow ノードが fs / localFile を使うために必要:
#   NODE_FUNCTION_ALLOW_BUILTIN=fs
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# （これらはn8nプロセスの環境変数として設定する。下の行は控え）
NODE_FUNCTION_ALLOW_BUILTIN=fs
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- SNS プラットフォーム認証 ----------------------------------
# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram / Threads (Meta Graph API)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- 画像生成（designer 用） -----------------------------------
IMAGE_GEN_PROVIDER=
IMAGE_GEN_API_KEY=

# --- ストレージ / DB -------------------------------------------
DATABASE_URL=
ASSET_STORAGE_BUCKET=

# --- 運用設定 --------------------------------------------------
COMPANY_TIMEZONE=Asia/Tokyo
# 投稿前に人間の承認を必須にするか (true/false)
HUMAN_APPROVAL_REQUIRED=true
# 通知先（Slack Webhook 等）
NOTIFY_WEBHOOK_URL=
